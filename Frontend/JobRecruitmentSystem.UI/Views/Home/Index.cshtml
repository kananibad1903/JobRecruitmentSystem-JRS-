@model JobPostListViewModel
@{
    ViewData["Title"] = Loc.T("home.title");
}

<div class="mb-4">
    <h1 class="h3">@Loc.T("home.title")</h1>
    <p class="text-muted">@Loc.T("home.subtitle")</p>
</div>

<form method="get" asp-controller="Home" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-3">
        <input type="text" class="form-control" name="category" placeholder="@Loc.T("common.category")" value="@Model.Category" />
    </div>
    <div class="col-md-3">
        <input type="text" class="form-control" name="location" placeholder="@Loc.T("common.location")" value="@Model.Location" />
    </div>
    <div class="col-md-2">
        <input type="text" class="form-control" name="jobType" placeholder="@Loc.T("common.jobType")" value="@Model.JobType" />
    </div>
    <div class="col-md-2">
        <input type="number" class="form-control" name="minSalary" placeholder="@Loc.T("common.minSalary")" value="@Model.MinSalary" />
    </div>
    <div class="col-md-2">
        <input type="number" class="form-control" name="maxSalary" placeholder="@Loc.T("common.maxSalary")" value="@Model.MaxSalary" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@Loc.T("common.search")</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@Loc.T("common.cancel")</a>
    </div>
</form>

@if (!Model.Jobs.Any())
{
    <p class="text-muted">@Loc.T("home.noResults")</p>
}
else
{
    <div class="row g-3">
        @foreach (var job in Model.Jobs)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card job-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@job.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@job.CompanyName</h6>
                        <p class="mb-1"><small>📍 @job.Location &nbsp;•&nbsp; 🕘 @job.JobType</small></p>
                        <p class="mb-2"><strong>@Loc.T("home.salary"):</strong> @job.SalaryMin.ToString("N0") - @job.SalaryMax.ToString("N0")</p>
                        <p class="text-muted small mb-3">@Loc.T("home.deadline"): @job.Deadline.ToString("dd.MM.yyyy")</p>
                        <a asp-controller="JobPost" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary mt-auto">@Loc.T("home.viewDetails")</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
