@model CandidateProfileViewModel
@{
    ViewData["Title"] = Model.FullName;
    var apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? string.Empty).Replace("/api", string.Empty);
}

<div class="mb-3">
    <a asp-controller="Employer" asp-action="MyPosts" class="text-decoration-none"><i class="bi bi-arrow-left"></i> @Loc.T("common.back")</a>
</div>

<div class="card">
    <div class="card-body">
        <h1 class="h3 mb-1"><i class="bi bi-person-circle text-primary me-2"></i>@Model.FullName</h1>
        <p class="text-muted mb-4"><i class="bi bi-envelope"></i> @Model.Email</p>

        <h5><i class="bi bi-stars text-primary me-1"></i>@Loc.T("jobseeker.skills")</h5>
        <p style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Model.Skills) ? Loc.T("common.none") : Model.Skills)</p>

        <h5><i class="bi bi-briefcase text-primary me-1"></i>@Loc.T("jobseeker.workExperience")</h5>
        <p style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Model.WorkExperience) ? Loc.T("common.none") : Model.WorkExperience)</p>

        <h5><i class="bi bi-file-earmark-text text-primary me-1"></i>@Loc.T("jobseeker.cv")</h5>
        @if (!string.IsNullOrWhiteSpace(Model.CvFilePath))
        {
            <a href="@(apiBaseUrl + Model.CvFilePath)" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi bi-download me-1"></i>@Loc.T("jobseeker.currentCv")</a>
        }
        else
        {
            <p class="text-muted">@Loc.T("jobseeker.noCv")</p>
        }
    </div>
</div>
