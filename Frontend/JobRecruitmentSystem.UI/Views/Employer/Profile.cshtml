@model EmployerProfileViewModel
@{
    ViewData["Title"] = Loc.T("employer.profileTitle");
}

<div class="row justify-content-center g-4">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-4"><i class="bi bi-building text-primary me-2"></i>@Loc.T("employer.profileTitle")</h1>

        <form asp-controller="Employer" asp-action="Profile" method="post" class="js-loading-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("employer.companyName")</label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("employer.companyDescription")</label>
                <textarea asp-for="CompanyDescription" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("employer.companyLocation")</label>
                <input asp-for="CompanyLocation" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("employer.website")</label>
                <input asp-for="Website" class="form-control" />
                <span asp-validation-for="Website" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">@Loc.T("common.submit")</button>
        </form>
    </div>
    <div class="col-md-4 col-lg-3">
        <partial name="_CareerQuote" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
