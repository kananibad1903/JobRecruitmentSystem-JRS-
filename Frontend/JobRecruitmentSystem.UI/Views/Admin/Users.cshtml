@model List<AdminUserViewModel>
@{
    ViewData["Title"] = Loc.T("admin.usersTitle");
    Layout = "_AdminLayout";
}

<h1 class="h3 mb-4"><i class="bi bi-people-fill text-primary me-2"></i>@Loc.T("admin.usersTitle")</h1>

@if (!Model.Any())
{
    <partial name="_EmptyState" model="@Loc.T("admin.noUsers")" />
}
else
{
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <div class="btn-group" role="group" id="admin-role-filter">
            <button type="button" class="btn btn-outline-primary active" data-role-filter="all">@Loc.T("admin.filterAll")</button>
            <button type="button" class="btn btn-outline-primary" data-role-filter="Employer">@Loc.T("admin.filterEmployers")</button>
            <button type="button" class="btn btn-outline-primary" data-role-filter="JobSeeker">@Loc.T("admin.filterJobSeekers")</button>
        </div>
        <div class="flex-grow-1" style="min-width:220px; max-width:320px;">
            <input type="text" id="admin-user-search" class="form-control" placeholder="@Loc.T("admin.searchPlaceholder")" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle bg-white" id="admin-users-table">
            <thead>
                <tr>
                    <th>@Loc.T("auth.fullName")</th>
                    <th>@Loc.T("auth.email")</th>
                    <th>@Loc.T("admin.role")</th>
                    <th>@Loc.T("admin.emailConfirmed")</th>
                    <th>@Loc.T("admin.createdAt")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr data-role="@user.Role" data-search="@($"{user.FullName} {user.Email}".ToLowerInvariant())">
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-secondary">@user.Role</span></td>
                        <td>@(user.EmailConfirmed ? Loc.T("common.yes") : Loc.T("common.no"))</td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (user.Role != "Admin")
                            {
                                <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post" data-confirm="@Loc.T("common.confirmDelete")">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">@Loc.T("admin.deleteUser")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p id="admin-users-empty" class="text-muted d-none">@Loc.T("admin.noUsers")</p>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var roleButtons = document.querySelectorAll('#admin-role-filter [data-role-filter]');
            var searchInput = document.getElementById('admin-user-search');
            var rows = document.querySelectorAll('#admin-users-table tbody tr');
            var emptyMessage = document.getElementById('admin-users-empty');
            var activeRole = 'all';

            function applyFilter() {
                var term = (searchInput.value || '').trim().toLowerCase();
                var visibleCount = 0;

                rows.forEach(function (row) {
                    var matchesRole = activeRole === 'all' || row.getAttribute('data-role') === activeRole;
                    var matchesSearch = !term || row.getAttribute('data-search').indexOf(term) !== -1;
                    var visible = matchesRole && matchesSearch;
                    row.classList.toggle('d-none', !visible);
                    if (visible) { visibleCount++; }
                });

                emptyMessage.classList.toggle('d-none', visibleCount !== 0);
            }

            roleButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    roleButtons.forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    activeRole = btn.getAttribute('data-role-filter');
                    applyFilter();
                });
            });

            searchInput.addEventListener('input', applyFilter);
        })();
    </script>
}
