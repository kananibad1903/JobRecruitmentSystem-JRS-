@model List<SavedJobViewModel>
@{
    ViewData["Title"] = Loc.T("jobseeker.savedJobsTitle");
}

<h1 class="h3 mb-4"><i class="bi bi-bookmark-heart text-primary me-2"></i>@Loc.T("jobseeker.savedJobsTitle")</h1>

@if (!Model.Any())
{
    <partial name="_EmptyState" model="@Loc.T("jobseeker.noSavedJobs")" />
}
else
{
    <div class="row g-3">
        @foreach (var job in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card job-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@job.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@job.CompanyName</h6>
                        <p class="mb-3"><small>📍 @job.Location</small></p>
                        <div class="d-flex gap-2 mt-auto">
                            <a asp-controller="JobPost" asp-action="Details" asp-route-id="@job.JobPostId" class="btn btn-outline-primary btn-sm">@Loc.T("home.viewDetails")</a>
                            <form asp-controller="JobSeeker" asp-action="RemoveSavedJob" asp-route-jobPostId="@job.JobPostId" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">@Loc.T("common.remove")</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
