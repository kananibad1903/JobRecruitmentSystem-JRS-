@model LoginViewModel
@{
    ViewData["Title"] = Loc.T("auth.loginTitle");
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-4 text-center">@Loc.T("auth.loginTitle")</h1>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.email")</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.password")</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-end">
                <a asp-controller="Account" asp-action="ForgotPassword" class="small">@Loc.T("auth.forgotPassword")</a>
            </div>

            <button type="submit" class="btn btn-primary w-100">@Loc.T("auth.loginButton")</button>
        </form>

        <p class="text-center mt-3">
            @Loc.T("auth.noAccount")
            <a asp-controller="Account" asp-action="Register">@Loc.T("nav.register")</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
