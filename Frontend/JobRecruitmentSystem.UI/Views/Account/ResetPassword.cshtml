@model ResetPasswordViewModel
@{
    ViewData["Title"] = Loc.T("auth.resetPasswordTitle");
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
            <h1 class="h3 mb-4 text-center">@Loc.T("auth.resetPasswordTitle")</h1>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" class="js-loading-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label">@Loc.T("auth.email")</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">@Loc.T("auth.confirmCode")</label>
                    <input asp-for="Code" class="form-control" maxlength="6" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">@Loc.T("auth.newPassword")</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">@Loc.T("auth.resetButton")</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
