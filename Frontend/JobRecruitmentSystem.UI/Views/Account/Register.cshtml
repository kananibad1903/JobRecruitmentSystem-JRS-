@model RegisterViewModel
@{
    ViewData["Title"] = Loc.T("auth.registerTitle");
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-4 text-center">@Loc.T("auth.registerTitle")</h1>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.fullName")</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.email")</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.password")</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc.T("auth.role")</label>
                <select asp-for="Role" class="form-select">
                    <option value="JobSeeker">@Loc.T("auth.roleJobSeeker")</option>
                    <option value="Employer">@Loc.T("auth.roleEmployer")</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">@Loc.T("auth.registerButton")</button>
        </form>

        <p class="text-center mt-3">
            @Loc.T("auth.haveAccount")
            <a asp-controller="Account" asp-action="Login">@Loc.T("nav.login")</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
