@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Loc.T("admin.dashboard")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="d-flex" style="min-height:100vh;">
        <aside class="admin-sidebar text-light p-3">
            <div class="d-flex align-items-center gap-2 mb-4">
                <span class="brand-mark" style="font-size:1.2rem;">qar<span class="brand-mark-accent">İŞ</span>qa</span>
            </div>
            <div class="text-uppercase small text-white-50 mb-2 ps-2">@Loc.T("admin.dashboard")</div>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i> @Loc.T("nav.adminUsers")</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "PendingJobPosts" ? "active" : "")" asp-controller="Admin" asp-action="PendingJobPosts"><i class="bi bi-hourglass-split"></i> @Loc.T("nav.adminPending")</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "JobPosts" ? "active" : "")" asp-controller="Admin" asp-action="JobPosts"><i class="bi bi-briefcase-fill"></i> @Loc.T("nav.adminAll")</a>
                </li>
            </ul>
            <hr class="text-white-50" />
            <a class="d-block mb-2 text-light-emphasis small" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> @Loc.T("nav.backToSite")</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-light btn-sm w-100">@Loc.T("nav.logout")</button>
            </form>
        </aside>

        <div class="flex-grow-1 p-4">
            @if (TempData["Success"] is string successKey)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Loc.T(successKey)
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string errorKey)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorKey
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <div id="page-loading-overlay" class="page-loading-overlay d-none" aria-hidden="true">
        <div class="ant-loader">
            <span class="ant-loader-dot"></span>
            <span class="ant-loader-dot"></span>
            <span class="ant-loader-dot"></span>
        </div>
        <p class="ant-loader-text">@Loc.T("common.loading")</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
