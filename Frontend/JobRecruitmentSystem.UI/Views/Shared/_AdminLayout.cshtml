@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Loc.T("admin.dashboard")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <div class="d-flex" style="min-height:100vh;">
        <aside class="bg-dark text-light p-3" style="width:240px;flex-shrink:0;">
            <h5 class="mb-4">⚙ @Loc.T("admin.dashboard")</h5>
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "Users" ? "active" : "text-light")" asp-controller="Admin" asp-action="Users">@Loc.T("nav.adminUsers")</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "PendingJobPosts" ? "active" : "text-light")" asp-controller="Admin" asp-action="PendingJobPosts">@Loc.T("nav.adminPending")</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "JobPosts" ? "active" : "text-light")" asp-controller="Admin" asp-action="JobPosts">@Loc.T("nav.adminAll")</a>
                </li>
            </ul>
            <hr class="text-secondary" />
            <a class="d-block mb-2 text-light-emphasis small" asp-controller="Home" asp-action="Index">&larr; @Loc.T("nav.backToSite")</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-light btn-sm w-100">@Loc.T("nav.logout")</button>
            </form>
        </aside>

        <div class="flex-grow-1 p-4">
            @if (TempData["Success"] is string successKey)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Loc.T(successKey)
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string errorKey)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorKey
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
