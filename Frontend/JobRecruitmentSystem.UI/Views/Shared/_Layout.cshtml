@{
    var currentCulture = Loc.CurrentCulture;
    var cultureNames = new Dictionary<string, string> { { "az", "AZ" }, { "en", "EN" }, { "ru", "RU" }, { "tr", "TR" } };
    var cultureFlags = new Dictionary<string, string> { { "az", "🇦🇿" }, { "en", "🇬🇧" }, { "ru", "🇷🇺" }, { "tr", "🇹🇷" } };
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @Loc.T("brand")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="@Loc.T("brand")" class="brand-logo" onerror="this.style.display='none'" />
                    <span class="brand-mark">qar<span class="brand-mark-accent">İŞ</span>qa</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-briefcase me-1"></i>@Loc.T("nav.jobs")</a></li>

                        @if (User.IsInRole("JobSeeker"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="JobSeeker" asp-action="Profile"><i class="bi bi-person-circle me-1"></i>@Loc.T("nav.myProfile")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="JobSeeker" asp-action="MyApplications"><i class="bi bi-send-check me-1"></i>@Loc.T("nav.myApplications")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="JobSeeker" asp-action="SavedJobs"><i class="bi bi-bookmark-heart me-1"></i>@Loc.T("nav.savedJobs")</a></li>
                        }
                        else if (User.IsInRole("Employer"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employer" asp-action="MyPosts"><i class="bi bi-card-list me-1"></i>@Loc.T("nav.myPosts")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Employer" asp-action="Create"><i class="bi bi-plus-circle me-1"></i>@Loc.T("nav.newPost")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Employer" asp-action="Profile"><i class="bi bi-building me-1"></i>@Loc.T("nav.companyProfile")</a></li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-speedometer2 me-1"></i>@Loc.T("nav.adminPanel")</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @cultureFlags.GetValueOrDefault(currentCulture, "🌐") @cultureNames.GetValueOrDefault(currentCulture, currentCulture.ToUpperInvariant())
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var culture in JobRecruitmentSystem.UI.Services.Localization.JsonLocalizer.SupportedCultures)
                                {
                                    <li>
                                        <form asp-controller="Language" asp-action="SetLanguage" method="post" class="px-3 py-1">
                                            <input type="hidden" name="culture" value="@culture" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="dropdown-item p-0 border-0 bg-transparent @(culture == currentCulture ? "fw-bold" : "")">
                                                @cultureFlags.GetValueOrDefault(culture, "🌐") @cultureNames.GetValueOrDefault(culture, culture.ToUpperInvariant())
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </li>

                        @if (User.Identity is { IsAuthenticated: true })
                        {
                            <li class="nav-item d-flex align-items-center">
                                <partial name="_NotificationBell" />
                            </li>
                            <li class="nav-item"><span class="nav-link text-light-emphasis"><i class="bi bi-person-fill me-1"></i>@User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">@Loc.T("nav.logout")</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">@Loc.T("nav.login")</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">@Loc.T("nav.register")</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Success"] is string successKey)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Loc.T(successKey)
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string errorKey)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorKey
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Info"] is string infoKey)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @Loc.T(infoKey)
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 mt-5 text-center text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year @Loc.T("brand") &mdash; @Loc.T("footer.rights")
        </div>
    </footer>

    @if (!User.IsInRole("Admin"))
    {
        <partial name="_ChatWidget" />
    }

    <div id="page-loading-overlay" class="page-loading-overlay d-none" aria-hidden="true">
        <div class="ant-loader">
            <span class="ant-loader-dot"></span>
            <span class="ant-loader-dot"></span>
            <span class="ant-loader-dot"></span>
        </div>
        <p class="ant-loader-text">@Loc.T("common.loading")</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
