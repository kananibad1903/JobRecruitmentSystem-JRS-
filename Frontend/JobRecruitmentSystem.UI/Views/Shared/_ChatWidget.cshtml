<div id="chat-widget">
    <button id="chat-toggle-btn" type="button" class="btn btn-primary rounded-circle shadow" aria-label="Chat">💬</button>

    <div id="chat-box" class="card shadow d-none">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>@Loc.T("chat.title")</span>
            <button id="chat-close-btn" type="button" class="btn-close btn-close-white" aria-label="@Loc.T("common.close")"></button>
        </div>
        <div id="chat-messages" class="card-body">
            <div class="chat-message chat-message-bot">@Loc.T("chat.greeting")</div>
        </div>
        <div class="card-footer">
            <form id="chat-form" class="d-flex gap-2">
                <input id="chat-input" type="text" class="form-control" placeholder="@Loc.T("chat.placeholder")" autocomplete="off" />
                <button type="submit" class="btn btn-primary">@Loc.T("common.send")</button>
            </form>
        </div>
    </div>
</div>

<script src="~/js/chat.js" asp-append-version="true"></script>
